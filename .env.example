# Priva's configuration: your Apple team, your Supabase project and your Cloudflare relay.
# Copy this file to .env (git ignores it), fill it in, then run:
#
#   scripts/configure.sh          the app's build settings (Config/Secrets.xcconfig), before building in Xcode
#   scripts/setup_supabase.sh     database, functions and settings on Supabase
#   scripts/setup_cloudflare.sh   the rendezvous relay on Cloudflare Workers
#
# Format: KEY=value, one per line, comments on their own lines. Nothing in .env is ever executed.

# ── The app ───────────────────────────────────────────────────────────────────────────────────────
# Built into Priva. None of these are secret (they ship inside the app), but they're yours.

# Apple Developer Team ID (developer.apple.com › Membership details; Xcode › Signing & Capabilities).
PRIVA_TEAM_ID=
# Your Supabase project's host: <project-ref>.supabase.co
PRIVA_SUPABASE_HOST=
# Supabase › Project Settings › API Keys › Publishable key (sb_publishable_…). Client-safe by design.
PRIVA_SUPABASE_PUBLISHABLE_KEY=
# SECRET. Signs development purchases (Debug builds have no App Store receipt): only builds made with this key
# can use them, even while allow_dev_purchases is on. Debug builds only, never Release. Make one with
# `openssl rand -hex 32`; scripts/setup_supabase.sh gives it to the server.
PRIVA_DEV_PURCHASE_KEY=
# The rendezvous Worker's host: priva-rendezvous.<your-subdomain>.workers.dev
PRIVA_RELAY_HOST=
# The registration and relay-pass signing keys the app pins (SHA-256 of each public key, hex).
# scripts/setup_supabase.sh prints both once the functions are deployed.
PRIVA_TOKEN_KEY_ID=
PRIVA_PASS_KEY_ID=

# ── Supabase ──────────────────────────────────────────────────────────────────────────────────────
# The project ref (the part before .supabase.co).
SUPABASE_PROJECT_REF=
# SECRET. Project Settings › Database › Connection string (URI, session pooler). Used to read and change
# Priva's settings and for scripts/launch_check.sh. Never put it anywhere else.
SUPABASE_DB_URL=
# Development builds have no App Store receipt; while this is true the server accepts a stand-in. It MUST be
# false for release, or anyone can get usernames without buying Priva.
PRIVA_ALLOW_DEV_PURCHASES=false

# ── Cloudflare ────────────────────────────────────────────────────────────────────────────────────
# The account the relay is deployed to (dashboard › Workers & Pages › Account ID). The setup script refuses
# to deploy unless wrangler is signed in to this account.
CLOUDFLARE_ACCOUNT_ID=
# The relay-pass public key (base64 SPKI): the relay accepts passes signed by it. Printed by
# scripts/setup_supabase.sh.
RELAY_PASS_SPKI=
# SECRET. Cloudflare › Realtime › TURN › your key: its ID and API token. Optional: without them phones connect
# directly (STUN only), and some carrier networks won't connect at all.
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=

# ── Testing on a real iPhone (the developer's own test scripts) ──────────────────────────────────
# The iPhone the on-device journeys run on: its UDID (xcrun xctrace list devices). Simulators are found by name.
PRIVA_DEVICE_UDID=
