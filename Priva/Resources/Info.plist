<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Priva</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Priva Backup</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.sanketdesai.priva.backup</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sanketdesai.priva.add</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>priva</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Priva uses the camera for end-to-end encrypted video calls and for scanning friends' codes.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Priva requires Face ID together with your password to unlock your encrypted vault.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Priva connects directly to your contacts on the same network for faster, private calls and transfers.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Priva uses the microphone for end-to-end encrypted voice and video calls.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Priva saves only the photos and videos you choose to your library.</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.sanketdesai.priva</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Priva</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>PrivaDevPurchaseKey</key>
	<string>$(PRIVA_DEV_PURCHASE_KEY)</string>
	<key>PrivaPassKeyID</key>
	<string>$(PRIVA_PASS_KEY_ID)</string>
	<key>PrivaRelayHost</key>
	<string>$(PRIVA_RELAY_HOST)</string>
	<key>PrivaSupabaseHost</key>
	<string>$(PRIVA_SUPABASE_HOST)</string>
	<key>PrivaSupabasePublishableKey</key>
	<string>$(PRIVA_SUPABASE_PUBLISHABLE_KEY)</string>
	<key>PrivaSupportEmail</key>
	<string>hello@jexxa.org</string>
	<key>PrivaTokenKeyID</key>
	<string>$(PRIVA_TOKEN_KEY_ID)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Priva Backup</string>
			<key>UTTypeIdentifier</key>
			<string>com.sanketdesai.priva.backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>privabackup</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Priva Key</string>
			<key>UTTypeIdentifier</key>
			<string>com.sanketdesai.priva.key</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>privakey</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
